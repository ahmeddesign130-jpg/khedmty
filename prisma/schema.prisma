generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum EscrowLedgerType {
  HOLD
  PROVIDER_RELEASE
  PLATFORM_FEE
  CUSTOMER_REFUND
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum DisputeResolution {
  RELEASE_TO_PROVIDER
  REFUND_CUSTOMER
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  role           UserRole   @default(CUSTOMER)
  status         UserStatus @default(ACTIVE)
  displayName    String     @default("مستخدم")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  profile        Profile?
  services       Service[]  @relation("ProviderServices")
  customerOrders Order[]    @relation("CustomerOrders")
  providerOrders Order[]    @relation("ProviderOrders")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  bio         String?  @db.Text
  avatarUrl   String?
  phone       String?
  skills      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          String        @id @default(cuid())
  serviceNo   String        @unique
  title       String
  description String
  price       Int
  mediaUrls   String[]      @default([])
  reviewNote  String?       @db.Text
  status      ServiceStatus @default(DRAFT)
  providerId  String
  provider    User          @relation("ProviderServices", fields: [providerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNo         String      @unique
  serviceId       String
  customerId      String
  customerContact String?     @db.Text
  providerId      String
  servicePrice    Int
  commissionRate  Int         @default(100)
  commission      Int
  total           Int
  status          OrderStatus @default(PENDING_PAYMENT)

  customer           User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  provider           User                 @relation("ProviderOrders", fields: [providerId], references: [id])
  payments           Payment[]
  escrow             OrderEscrow?
  dispute            OrderDispute?
  escrowLedgerEntries EscrowLedgerEntry[]
  createdAt          DateTime             @default(now())
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      String
  receiptUrl  String?
  amount      Int
  status      PaymentStatus @default(PENDING_REVIEW)
  reviewNote  String?
  reviewedAt  DateTime?

  order     Order        @relation(fields: [orderId], references: [id])
  escrow    OrderEscrow?
  createdAt DateTime     @default(now())
}

model OrderEscrow {
  id                String       @id @default(cuid())
  orderId           String       @unique
  paymentId         String       @unique
  amount            Int
  providerAmount    Int
  platformFee       Int
  status            EscrowStatus @default(HELD)
  resolutionNote    String?      @db.Text
  externalReference String?
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  order         Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment       Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ledgerEntries EscrowLedgerEntry[]
}

model EscrowLedgerEntry {
  id                String           @id @default(cuid())
  escrowId          String
  orderId           String
  type              EscrowLedgerType
  amount            Int
  idempotencyKey    String           @unique
  actorId           String
  externalReference String?
  details           String?          @db.Text
  createdAt         DateTime         @default(now())

  escrow OrderEscrow @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  order  Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([escrowId, createdAt])
}

model OrderDispute {
  id             String             @id @default(cuid())
  orderId        String             @unique
  openedById     String
  reason         String             @db.Text
  status         DisputeStatus      @default(OPEN)
  resolution     DisputeResolution?
  resolutionNote String?            @db.Text
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model PlatformSettings {
  id             String   @id @default("main")
  commissionRate Int      @default(100)
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  details   String?
  createdAt DateTime @default(now())
}
