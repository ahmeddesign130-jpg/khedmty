generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { CUSTOMER PROVIDER SUPER_ADMIN }
enum UserStatus { ACTIVE PENDING SUSPENDED }
enum ServiceStatus { DRAFT PENDING_REVIEW APPROVED REJECTED PAUSED }
enum OrderStatus { PENDING_PAYMENT PAYMENT_REVIEW PAID IN_PROGRESS DELIVERED DELIVERY_REVIEW REVISION_REQUESTED COMPLETED CANCELLED REJECTED }
enum PaymentStatus { PENDING_REVIEW APPROVED REJECTED }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role UserRole @default(CUSTOMER)
  status UserStatus @default(ACTIVE)
  displayName String @default("مستخدم")
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  termsVersion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile Profile?
  emailOtp EmailOtp?
  notifications Notification[]
  services Service[] @relation("ProviderServices")
  customerOrders Order[] @relation("CustomerOrders")
  providerOrders Order[] @relation("ProviderOrders")
}
model EmailOtp {
  id String @id @default(cuid())
  userId String @unique
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  consumedAt DateTime?
  lastSentAt DateTime @default(now())
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model Profile {
  id String @id @default(cuid())
  userId String @unique
  displayName String?
  bio String? @db.Text
  avatarUrl String?
  phone String?
  skills String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Service {
  id String @id @default(cuid())
  serviceNo String @unique
  title String
  description String
  category String @default("أخرى")
  subcategory String @default("عام")
  requirements String[] @default([])
  price Int
  mediaUrls String[] @default([])
  reviewNote String? @db.Text
  status ServiceStatus @default(DRAFT)
  providerId String
  provider User @relation("ProviderServices", fields: [providerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, category, subcategory])
  @@index([status, price])
}
model Order {
  id String @id @default(cuid())
  orderNo String @unique
  serviceId String
  customerId String
  customerContact String? @db.Text
  requirementsAnswers String? @db.Text
  providerId String
  servicePrice Int
  commissionRate Int @default(20)
  commission Int
  providerNet Int @default(0)
  total Int
  status OrderStatus @default(PENDING_PAYMENT)
  customer User @relation("CustomerOrders", fields: [customerId], references: [id])
  provider User @relation("ProviderOrders", fields: [providerId], references: [id])
  payments Payment[]
  deliveryFiles OrderDeliveryFile[]
  createdAt DateTime @default(now())
}
model Payment {
  id String @id @default(cuid())
  orderId String
  method String
  receiptUrl String?
  amount Int
  status PaymentStatus @default(PENDING_REVIEW)
  reviewNote String?
  reviewedAt DateTime?
  transferReference String?
  transferDate DateTime?
  aiReceiptStatus String?
  aiReceiptAmount Int?
  aiReceiptConfidence Int?
  aiReceiptNotes String? @db.Text
  aiReceiptCheckedAt DateTime?
  order Order @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}
model PlatformSettings {
  id String @id @default("main")
  commissionRate Int @default(20)
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  targetId String
  details String?
  createdAt DateTime @default(now())
}
model OrderDeliveryFile {
  id String @id @default(cuid())
  orderId String
  uploaderId String
  objectPath String @unique
  fileName String
  mimeType String
  sizeBytes Int
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  title String
  body String @db.Text
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}