generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  IN_PROGRESS
  DELIVERED
  DELIVERY_REVIEW
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DigitalProductStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
}

enum DigitalPurchaseStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  REJECTED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  displayName     String     @default("مستخدم")
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile          Profile?
  emailOtp         EmailOtp?
  notifications    Notification[]
  store            Store?
  digitalBuyerPurchases DigitalPurchase[] @relation("DigitalBuyer")
  digitalSellerPurchases DigitalPurchase[] @relation("DigitalSeller")
  services         Service[] @relation("ProviderServices")
  customerOrders   Order[]   @relation("CustomerOrders")
  providerOrders   Order[]   @relation("ProviderOrders")
}

model EmailOtp {
  id         String    @id @default(cuid())
  userId     String    @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  bio         String?  @db.Text
  avatarUrl   String?
  phone       String?
  skills      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          String        @id @default(cuid())
  serviceNo   String        @unique
  title       String
  description String
  price       Int
  mediaUrls   String[]      @default([])
  reviewNote  String?       @db.Text
  status      ServiceStatus @default(DRAFT)
  providerId  String
  provider    User          @relation("ProviderServices", fields: [providerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNo         String      @unique
  serviceId       String
  customerId      String
  customerContact String?     @db.Text
  providerId      String
  servicePrice    Int
  commissionRate  Int         @default(20)
  commission      Int
  providerNet     Int         @default(0)
  total           Int
  status          OrderStatus @default(PENDING_PAYMENT)

  customer  User      @relation("CustomerOrders", fields: [customerId], references: [id])
  provider  User      @relation("ProviderOrders", fields: [providerId], references: [id])
  payments      Payment[]
  deliveryFiles OrderDeliveryFile[]
  createdAt     DateTime  @default(now())
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      String
  receiptUrl  String?
  amount      Int
  status      PaymentStatus @default(PENDING_REVIEW)
  reviewNote  String?
  reviewedAt  DateTime?
  transferReference String?
  transferDate DateTime?

  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id             String   @id @default("main")
  commissionRate Int      @default(20)
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  details   String?
  createdAt DateTime @default(now())
}


model OrderDeliveryFile {
  id         String   @id @default(cuid())
  orderId    String
  uploaderId String
  objectPath String   @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.Text
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}


model Store {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  name        String
  slug        String   @unique
  description String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    DigitalProduct[]
}

model DigitalProduct {
  id          String               @id @default(cuid())
  storeId     String
  title       String
  description String               @db.Text
  price       Int
  filePath    String
  fileName    String
  mimeType    String
  sizeBytes   Int
  coverUrl    String?
  status      DigitalProductStatus @default(PENDING_REVIEW)
  reviewNote  String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchases   DigitalPurchase[]
  @@index([storeId, status, createdAt])
}

model DigitalPurchase {
  id              String                @id @default(cuid())
  purchaseNo      String                @unique
  productId       String
  buyerId         String
  sellerId        String
  productPrice    Int
  commissionRate  Int                   @default(20)
  commission      Int
  sellerNet       Int
  total           Int
  status          DigitalPurchaseStatus @default(PENDING_PAYMENT)
  paymentMethod   String?
  receiptPath     String?
  reviewNote      String?               @db.Text
  transferReference String?
  transferDate    DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  product         DigitalProduct        @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer           User                  @relation("DigitalBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller          User                  @relation("DigitalSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}
